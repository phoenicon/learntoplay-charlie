# Copy this file to ".env" and paste your key in. .env is git-ignored — never commit it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: change the model the tutor uses.
#   claude-sonnet-5   → fast + strong, best value for a study app (default)
#   claude-opus-4-8   → highest quality, better for essay coaching, costs more
# LTP_MODEL=claude-sonnet-5

# Optional: change the port (default 8787)
# PORT=8787
